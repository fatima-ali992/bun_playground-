generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql" // or "cockroachdb" for CockroachDB
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  orders   Order[]
}

model Post {
  id      Int    @id @default(autoincrement())
  title   String
  content String
  test    String
}

model Product {
  id     Int     @id @default(autoincrement())
  name   String
  price  Float
  orders Order[]
}

model Order {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  productId Int
  quantity  Int
  total     Float
  products  Product[]
}
